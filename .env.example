# 后端环境变量示例
# 本地 Docker Compose 暴露 MySQL 到 3307，所以本机运行 FastAPI 时用 localhost:3307。
DATABASE_URL=mysql+pymysql://hotspot:hotspot123@localhost:3307/hotspot_agent?charset=utf8mb4
REDIS_URL=redis://localhost:6380/1
APP_TIMEZONE=Asia/Shanghai
# start.ps1 / backend container runs scripts/prepare_database.py before the app starts.
AUTO_CREATE_TABLES=false

# 交付态安全开关：后端默认要求 API 管理凭据。
# ADMIN_TOKEN 是后端 API 保护凭据；前台只用账号密码登录，上线必须把该值改成强随机值。
API_AUTH_ENABLED=true
REGISTRATION_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_ROLE=owner
# 运行 python scripts/hash_password.py 生成；bcrypt 值必须用单引号包裹，避免 Compose 展开其中的 $。
ADMIN_PASSWORD_BCRYPT=''
# 仅兼容旧部署，不建议新环境使用 SHA256。
ADMIN_PASSWORD_SHA256=
# 开发示例值仅用于本地首次启动；生产/交付验收必须替换为强随机值。
ADMIN_TOKEN=
APP_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCK_SECONDS=300
SESSION_TTL_SECONDS=28800
SESSION_REMEMBER_TTL_SECONDS=2592000
TRUSTED_PROXY_COUNT=0
BRIEFING_TASK_LOCK_SECONDS=14400
SCHEDULER_LOCK_FAIL_OPEN=false
LIVE_PROBE_CACHE_SECONDS=60
SOURCE_HEALTH_STALE_HOURS=36

# 生产 Docker 栈配置。两个密码没有默认值，prod-up.ps1 会在构建前校验；
# MYSQL_PASSWORD 请使用至少 16 位 URL-safe 随机值，CORS_ORIGINS 改为真实域名。
FRONTEND_PORT=8080
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hotspot_agent
MYSQL_USER=hotspot
MYSQL_PASSWORD=

# 没有 API Key 也能跑，系统会使用规则分析兜底。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
HOTSPOT_GITHUB_TOKEN=

SCHEDULER_ENABLED=true
DAILY_BRIEFING_HOUR=8
DAILY_BRIEFING_MINUTE=0
